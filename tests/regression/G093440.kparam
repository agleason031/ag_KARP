# Regression parameters for the G093440 test set (KOSMOS, blue grating, 2024-09-29).
# Values come from the parameter dump in the original run's KARP_log.txt.
# dloc and target_dir are overwritten by regress.py with absolute paths.
dloc = test_data/in/
target_dir = tests/regression/runs/unset/

objid = G093440
objRA = 23 50 59.00
objDEC = +2 36 15.5
# As in the original run's log. The real exposure start for frame 61 is 2024-09-29T05:27:03 (TAI).
obsTime = 2024-09-29 22:30:00.500

scistart = 61
scistop = 63
argnum = 64
fstart = 1
fstop = 7
bstart = 9
bstop = 17

# Detector layout (KOSMOS, 2x1 binning): 0-based, end-exclusive column ranges per amplifier
amp_data = [[0, 512], [512, 1024]]
amp_overscan = [[1034, 1074], [1084, 1124]]
# e-/ADU per amplifier. KOSMOS spec sheet: 0.6 e-/DN, read noise 6 e-, full well 150k e-.
# Photon-transfer on the 2024-09-29 flats gives ~0.72 (A) and ~0.77 (B) at low signal.
gain = [0.6, 0.6]
overscan_order = 3

appw = 20
buffw = 20
bckw = 25
# Trace: polynomial order, and an optional starting column (blank = find automatically)
trace_order = 3
trace_col =
norm_line_width = 250
norm_line_boxcar = 70

# Cosmic-ray cleaning of the 2D science frames (L.A.Cosmic); readnoise in electrons
cr_clean = true
readnoise = 5.7
cr_sigclip = 4.5

# Optional masking (blank = off). Masked pixels keep their values and get Mask != 0.
# The original code's clipping corresponds to:
#   norm_clip = 1.3, comb_clip = 1.25, comb_clip_regions = [[5500, 5700, 1.05]]
norm_clip =
comb_clip =
comb_clip_regions =

# Only used when fit_lines = true (16 lines). Placeholder; fit_lines is off for the baseline.
metal_mask = [2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2]

skip_red = false
spec_norm = true
comb_spec = true
fit_lines = false
optimize = false
verbose = false
# Play a short tone when KARP finishes
sound = false
